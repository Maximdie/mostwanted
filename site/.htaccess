# Всегда HTTPS и без www.
# Включить (убрать # в 5 строках ниже) ТОЛЬКО после того, как https://mostwanted.consulting открывается без ошибки сертификата.
# RewriteEngine On
# RewriteCond %{HTTPS} off [OR]
# RewriteCond %{HTTP_HOST} ^www\. [NC]
# RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
# RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

DirectoryIndex index.html
Options -Indexes
AddDefaultCharset UTF-8

# Сжатие
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/xml application/xml image/svg+xml
</IfModule>

# Кэш: картинки и стили надолго (CSS/JS обновляются через ?v=), HTML — без кэша
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
