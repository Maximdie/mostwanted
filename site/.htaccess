# Всегда HTTPS и без www
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# ---- Красивые адреса (ЧПУ): /about вместо /about.html ----
# Старые адреса с .html навсегда (301) ведут на новые — поисковики переносят на них всё накопленное.
RewriteRule ^services\.html$ /services/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+([^?\s]*?)(?:index)?\.html[?\s]
RewriteRule ^ /%1 [R=301,L,NE]

# Новости: /news/, /news/12-zagolovok, /news/sitemap.xml (старые /news.php?id=12 перенаправляет сам PHP)
RewriteRule ^news/?$ news.php [L,QSA]
RewriteRule ^news/sitemap\.xml$ news.php?format=sitemap [L]
RewriteRule ^news/(\d+)(?:-[a-z0-9-]*)?/?$ news.php?id=$1 [L,QSA]

# /about → about.html, /services/red-notice → services/red-notice.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

ErrorDocument 404 /404.html
DirectoryIndex index.html index.php
Options -Indexes
AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest
AddType image/x-icon .ico

# Сжатие
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/manifest+json text/xml application/xml image/svg+xml image/x-icon
</IfModule>

# Кэш: картинки и стили надолго (CSS/JS обновляются через ?v=), HTML — без кэша
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Служебные файлы не отдавать
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>
